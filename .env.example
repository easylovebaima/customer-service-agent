# 复制此文件为 .env 并填入自己的值

# ── 模型 ──────────────────────────────────────────────
# 可选 provider：deepseek / qwen / zhipu / ollama
# 三家云端全部走 OpenAI 兼容协议，切换只需改这一个值
LLM_PROVIDER=zhipu
LLM_API_KEY=在这里粘贴你的key
LLM_MODEL=glm-4-flash
LLM_BASE_URL=
LLM_TEMPERATURE=0.2

# ── 数据库 ────────────────────────────────────────────
# 生产环境用 PostgreSQL；本地没装 PG 时可改成 sqlite 跑通全部逻辑
# PostgreSQL 可用 docker-compose up -d 一键启动
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/cs_agent
# DATABASE_URL=sqlite:///./data/app.db
ALLOW_SQLITE_FALLBACK=1

# ── 检索链路 ──────────────────────────────────────────
# local = 本地词面嵌入（零依赖、离线可跑）；api = 调用厂商 embedding 接口
EMBEDDING_BACKEND=local
RETRIEVAL_TOP_K=4
# 低于此相似度视为没召回，会触发查询重写
MIN_RELEVANCE=0.12
# 查询重写最多几轮（每轮都要花一次模型调用，不能放开）
MAX_REWRITE_ROUNDS=2

# ── 服务 ──────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
